# Tabularium configuration
# Copy this file to .env and adjust as needed.

# Server
# PORT=8888
# HOST=::

# Default locale for API error messages
# LANG=en

# Authentication
# To enable auth, generate a session key and password hash:
#   node server/scripts/generate-key.js <your-password>
# Then uncomment and set:
# WIKI_SESSION_KEY=<64-hex-chars>
# WIKI_PASSWORD_HASH=<bcrypt-hash>
# Without these, auth is disabled (backward-compatible mode).

# Knowledge base roots (JSON array)
# KNOWLEDGE_ROOTS='[{"name":"wiki","path":"./knowledge"}]'
# KNOWLEDGE_BASE=./knowledge

# Database
# DATABASE_URL=postgres://user:pass@host/db
# PG_CONNECT_STRING=

# draw.io editor URL (default: bundled static files at /drawio)
# Set to use a self-hosted instance or the cloud version
# DRAWIO_URL=/drawio
# DRAWIO_URL=https://embed.diagrams.net

# Collabora Online (requires Podman)
# WOPI_SRC=http://localhost:8888
# COLLABORA_HOST=http://localhost:9980
# COLLABORA_SERVER_NAME=
# COLLABORA_USERNAME=admin
# COLLABORA_PASSWORD=secret
